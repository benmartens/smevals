+        try
+        {
+            var solved = SolveExact(problem);
+            if (solved is not null)
+            {
+                return solved;
+            }
+        }
+        catch (BudgetExceededException)
+        {
+            // Fall through to the greedy heuristic.
+        }
+
+        return SolveGreedy(problem);
