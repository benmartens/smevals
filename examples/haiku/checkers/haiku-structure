#!/usr/bin/env python3
"""Structure check: a haiku is exactly three non-empty lines.

Free and instant - no model calls. Emits the line count as a metric
and tags common failure shapes.
"""
import json
import os
import pathlib
import sys

raw = (pathlib.Path(os.environ["SMEVALS_RUN_DIR"]) / "output.txt").read_text()
# Tolerate surrounding blank lines and code fences
lines = [
    line for line in raw.strip().splitlines() if line.strip() and line.strip() != "```"
]

tags = []
if len(lines) == 0:
    tags.append("empty_response")
elif len(lines) == 1:
    tags.append("single_line")
elif len(lines) > 3:
    tags.append("too_many_lines")

result = {
    "score": 1.0 if len(lines) == 3 else 0.0,
    "metrics": {"line_count": len(lines)},
    "tags": tags,
    "notes": f"{len(lines)} non-empty line(s)",
}
print(json.dumps(result))
sys.exit(0 if len(lines) == 3 else 1)
